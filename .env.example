# Cổng HTTP/WebSocket của máy chủ
PORT=8080
# Địa chỉ công khai (dùng tạo link mời), ví dụ https://bida.example.com
PUBLIC_URL=http://localhost:8080
# Thư mục lưu dữ liệu giải đấu (JSON). Để trống = chỉ lưu trong RAM.
DATA_DIR=./data
# Giới hạn thời gian mỗi lượt đánh (mili-giây)
TURN_TIME_MS=60000
# Thời gian chờ người chơi kết nối lại trước khi xử thua (mili-giây)
RECONNECT_GRACE_MS=60000
