{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["Shared/src/*"],
      "@gameserver/*": ["GameServer/src/*"]
    }
  },
  "include": ["Shared/src", "GameServer/src", "Backend/src", "Tests"]
}
